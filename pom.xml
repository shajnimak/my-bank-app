<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/>
	</parent>

	<groupId>ru.yandex.practicum</groupId>
	<artifactId>my-bank-app</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>my-bank-app</name>
	<description>Микросервисное приложение «Банк»</description>

	<modules>
		<module>notifications-service</module>
		<module>accounts-service</module>
		<module>cash-service</module>
		<module>transfer-service</module>
		<module>gateway-service</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<spring-cloud.version>2025.0.3</spring-cloud.version>
		<spring-cloud-contract.version>4.3.4</spring-cloud-contract.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>ru.yandex.practicum</groupId>
				<artifactId>notifications-service</artifactId>
				<version>${project.version}</version>
				<classifier>stubs</classifier>
			</dependency>
			<dependency>
				<groupId>ru.yandex.practicum</groupId>
				<artifactId>accounts-service</artifactId>
				<version>${project.version}</version>
				<classifier>stubs</classifier>
			</dependency>
			<dependency>
				<groupId>ru.yandex.practicum</groupId>
				<artifactId>cash-service</artifactId>
				<version>${project.version}</version>
				<classifier>stubs</classifier>
			</dependency>
			<dependency>
				<groupId>ru.yandex.practicum</groupId>
				<artifactId>transfer-service</artifactId>
				<version>${project.version}</version>
				<classifier>stubs</classifier>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<finalName>${project.artifactId}</finalName>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.cloud</groupId>
					<artifactId>spring-cloud-contract-maven-plugin</artifactId>
					<version>${spring-cloud-contract.version}</version>
					<extensions>true</extensions>
					<configuration>
						<testFramework>JUNIT5</testFramework>
						<testMode>MOCKMVC</testMode>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
						<systemPropertyVariables>
							<spring.cloud.consul.enabled>false</spring.cloud.consul.enabled>
						</systemPropertyVariables>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>mockito-agent</id>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
